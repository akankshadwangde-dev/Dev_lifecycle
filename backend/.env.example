# Copy to backend/.env and adjust.

# true: sample work items, Confluence pages, SAP code and a sample model are used
# wherever no real connection or model is configured.
STUDIO_DEMO_MODE=true

# Where the databases are kept (work items, flow checkpoints, knowledge index).
# STUDIO_DATA_DIR=./data

# Secrets are referenced by name from Models and Connections, e.g. env:ANTHROPIC_API_KEY.
# Set the actual values as environment variables on the server, never in the database.
# ANTHROPIC_API_KEY=
# JIRA_TOKEN=
# CONFLUENCE_TOKEN=
# SAP_DEV_PASSWORD=
